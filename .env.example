# Kontrollrom-serveren (https://github.com/halloween-prosjektet/control-room).
# Kopier denne fila til .env og fyll inn. .env legges ikke i git.
#   - Editoren leser .env i prosjektmappa.
#   - På Pi-en: legg .env i samme mappe som spillfila (kjelleren.arm64).
# Ekte miljøvariabler med samme navn overstyrer fila.

# WebSocket-adressen til serveren. Pi-en må være på WiFi-et BakkaIM. Tom = av.
CONTROL_ROOM_URL=ws://172.31.0.200:7321

# Rom-nummeret vårt hos kontrollrommet (1-5). Bare rom 1 kan registrere grupper.
CONTROL_ROOM_PI_ID=1
